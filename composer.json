{
    "name": "freescout-helpdesk/freescout",
    "description": "Free self-hosted helpdesk and shared mailbox (Zendesk / Help Scout alternative)",
    "keywords": ["helpdesk", "help desk", "shared mailbox"],
    "license": "AGPL-3.0",
    "version": "dev-main",
    "authors": [
        {
            "name": "The FreeScout Team",
            "email": "support@freescout.net"
        }
    ],
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "codedge/laravel-selfupdater",
                "version": "dev-customized",
                "type": "library",
                "source": {
                    "type": "git",
                    "url": "https://github.com/freescout-help-desk/laravel-selfupdater.git",
                    "reference": "e80eefef4666d8882e510e55e1bbc5aa4844affb"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/freescout-help-desk/laravel-selfupdater/zipball/e80eefef4666d8882e510e55e1bbc5aa4844affb",
                    "reference": "e80eefef4666d8882e510e55e1bbc5aa4844affb",
                    "shasum": ""
                },
                "require": {
                    "ext-zip": "*",
                    "guzzlehttp/guzzle": "*",
                    "illuminate/support": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
                    "php": ">=5.5"
                },
                "autoload": {
                    "psr-4": {
                        "Codedge\\Updater\\": "src/"
                    }
                },
                "license": [
                    "MIT"
                ]
            }
        },
        {
            "type": "package",
            "package": {
                "name": "devfactory/minify",
                "version": "1.0.7",
                "type": "library",
                "source": {
                    "type": "git",
                    "url": "https://github.com/DevFactoryCH/minify.git",
                    "reference": "95d518081aa29c91b8c89243c61a7b1fc726120e"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/DevFactoryCH/minify/zipball/95d518081aa29c91b8c89243c61a7b1fc726120e",
                    "reference": "95d518081aa29c91b8c89243c61a7b1fc726120e",
                    "shasum": ""
                },
                "require": {
                    "illuminate/filesystem": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
                    "illuminate/support": "^5.0|^6.0|^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
                    "natxet/cssmin": "3.*",
                    "php": ">=5.4.0",
                    "tedivm/jshrink": "~1.0"
                },
                "autoload": {
                    "psr-4": {
                        "Devfactory\\Minify\\": "src/"
                    }
                },
                "license": [
                    "MIT"
                ]
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/freescout-help-desk/Purifier"
        }
    ],
    "require": {
        "php": ">=8.5",

        "devfactory/minify": "1.0.7",
        "laravel/framework": "v13.34.0",
        "laravel/tinker": "v3.0.0",
        "laravel/ai": "^1.0",
        "laravel/ui": "4.6.*",
        "mews/purifier": "dev-customized",
        "spatie/laravel-activitylog": "4.12.0",
        "html2text/html2text": "4.1.0",
        "watson/rememberable": "7.1.0",
        "nwidart/laravel-modules": "2.7.0",
        "tormjens/eventy": "0.5.4",
        "rap2hpoutre/laravel-log-viewer": "v3.0.0",
        "codedge/laravel-selfupdater": "dev-customized",
        "doctrine/dbal": "^3.5",
        "egulias/email-validator": "4.*",
        "symfony/console": "7.4.*",
        "javoscript/laravel-macroable-models": "1.0.7",
        "ramsey/uuid": "^4.7",
        "symfony/polyfill-mbstring": "v1.24.0",
        "webklex/php-imap": "^6.2",
        "enshrined/svg-sanitize": "0.22.0"
    },
    "require-dev": {
        "symfony/polyfill-ctype": "^1.17",
        "vlucas/phpdotenv": "5.6.*",
        "symfony/css-selector": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/polyfill-intl-idn": "v1.38.1",
        "symfony/http-foundation": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "psr/log": "2.0.*",
        "symfony/http-kernel": "7.4.*",
        "symfony/finder": "7.4.*",
        "doctrine/lexer": "^2.0",
        "symfony/translation": "7.4.*",
        "nesbot/carbon": "3.*",
        "league/flysystem": "^3.8",
        "doctrine/inflector": "^2.0.5",
        "guzzlehttp/guzzle": "8.0.1",
        "tedivm/jshrink": "1.4.0",
        "nikic/php-parser": "^5.0",
        "doctrine/cache": "^2.0",
        "psr/container": "^1.1.1"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories",
            "overrides/natxet/cssmin/src/"
        ],
        "files": [
            "app/Misc/Functions.php",
            "app/Misc/LegacyHelpers.php"
        ],
        "fs-comment": "Above new lines are listed files containing custom updates. Below - only PHP compatibility updates.",
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Codedge\\Updater\\SourceRepositoryTypes\\": "overrides/codedge/laravel-selfupdater/src/SourceRepositoryTypes/",
            "Illuminate\\Database\\": "overrides/laravel/framework/src/Illuminate/Database/",

            "Illuminate\\Support\\": "overrides/laravel/framework/src/Illuminate/Support/",
            "Illuminate\\Database\\Eloquent\\": "overrides/laravel/framework/src/Illuminate/Database/Eloquent/",
            "Illuminate\\Database\\Eloquent\\Concerns\\": "overrides/laravel/framework/src/Illuminate/Database/Eloquent/Concerns/",
            "Devfactory\\Minify\\Providers\\": "overrides/devfactory/minify/src/Providers/"
        },
        "exclude-from-classmap": [
            "Modules/",
            "vendor/codedge/laravel-selfupdater/src/SourceRepositoryTypes/GithubRepositoryType.php",

            "vendor/laravel/framework/src/Illuminate/Database/Eloquent/Model.php",
            "vendor/laravel/framework/src/Illuminate/Database/Eloquent/Concerns/HasAttributes.php",
            "vendor/devfactory/minify/src/Providers/BaseProvider.php",
            "vendor/natxet/cssmin/src/CssMin.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "pre-install-cmd": [
            "@php -r \"@mkdir('vendor/natxet/cssmin/src', 775);\""
        ],
        "post-autoload-dump": [
            "@php -r \"(error_reporting(0) || !error_reporting(0)) && array_map('unlink', json_decode(file_get_contents('composer.json'), true)['autoload']['exclude-from-classmap']);\"",
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-install-cmd": [
            "@php dev/install.php"
        ],
        "post-update-cmd": [
            "@php dev/install.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        },
        "platform-check": false
    }
}
