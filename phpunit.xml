<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" backupGlobals="false" bootstrap="tests/bootstrap.php" colors="true" stderr="true" processIsolation="false" stopOnFailure="false" xsi:noNamespaceSchemaLocation="dev/vendor/phpunit/phpunit/phpunit.xsd">
  <testsuites>
    <testsuite name="Feature">
      <directory suffix="Test.php">./tests/Feature</directory>
    </testsuite>
    <testsuite name="Unit">
      <directory suffix="Test.php">./tests/Unit</directory>
    </testsuite>
    <testsuite name="Snapshot">
      <directory suffix="Test.php">./tests/Snapshot</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="APP_ENV" value="testing"/>
    <env name="APP_URL" value="https://tallport.test"/>
    <env name="DB_CONNECTION" value="testing"/>
    <env name="CACHE_STORE" value="array"/>
    <env name="SESSION_DRIVER" value="array"/>
    <env name="QUEUE_CONNECTION" value="sync"/>
    <!-- Redis tests (skipped without a Redis server) use databases of their own. -->
    <env name="REDIS_DB" value="15"/>
    <env name="REDIS_CACHE_DB" value="14"/>
    <env name="REDIS_PREFIX" value="tallport-test-"/>
    <!-- Tests that keep raw sources of incoming email use a temporary folder. -->
    <env name="APP_INCOMING_MAIL_RETENTION_DAYS" value="0"/>
    <env name="APP_TWO_FACTOR_REQUIRED" value="false"/>
    <env name="APP_KEY" value="base64:dGFsbHBvcnQtdGVzdC1rZXktMzItYnl0ZXMtbG9uZyE="/>
  </php>
  <!-- Files never loaded by a test count as uncovered, so gaps show up. -->
  <coverage processUncoveredFiles="true">
    <include>
      <directory suffix=".php">./app</directory>
    </include>
  </coverage>
</phpunit>
