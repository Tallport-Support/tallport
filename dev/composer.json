{
    "name": "tallport/dev-tools",
    "description": "Development and test tools for Tallport. Installed into dev/vendor, which is not committed, so none of this ships with releases.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "fakerphp/faker": "^1.24",
        "infection/infection": "*",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.4",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^9.6",
        "psr/container": "1.1.*",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/process": "^7.4",
        "symfony/string": "^7.4"
    },
    "config": {
        "platform": {
            "php": "8.5.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
